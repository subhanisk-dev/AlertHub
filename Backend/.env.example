DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=alerthub
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
PORT=5000
FLASK_DEBUG=1
HOST=127.0.0.1
# Local uploads use Backend/uploads; deployments should set a persistent mounted directory.
# UPLOAD_DIR=
# Generate a local key pair with: node Backend/generate_vapid_keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.com
