# Copy this file to /etc/alerthub/alerthub.env on the AWS server and replace every example value.
APP_ENV=production
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
PUBLIC_DOMAIN=api.example.com
FRONTEND_ORIGIN=https://your-project.vercel.app
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alerthub
DB_USER=alerthub_runtime
DB_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MIGRATION_DB_USER=alerthub_migrator
MIGRATION_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARACTERS

UPLOAD_DIR=/var/lib/alerthub/uploads
VAPID_PUBLIC_KEY=REPLACE_WITH_THE_EXISTING_PUBLIC_VAPID_KEY
VAPID_PRIVATE_KEY=/etc/alerthub/vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.com
