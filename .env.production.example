# Copy to .env.production on the deployment host and replace every example value.
PUBLIC_DOMAIN=alerts.example.com
FRONTEND_ORIGIN=https://alerts.example.com
VITE_API_URL=

APP_ENV=production
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

DB_HOST=db
DB_PORT=3306
DB_NAME=alerthub
DB_USER=alerthub_runtime
MIGRATION_DB_USER=alerthub_migrator
MIGRATION_DB_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
MYSQL_RUNTIME_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

UPLOAD_DIR=/var/lib/alerthub/uploads
VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:admin@alerts.example.com
